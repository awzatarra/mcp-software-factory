OPENAI_API_KEY=
OPENAI_MODEL=
USE_LANGGRAPH=false
MCP_FACTORY_DEBUG=false
NOTIFICATION_WORKER_ENABLED=true
NOTIFICATION_WORKER_INTERVAL_SECONDS=5
NOTIFICATION_WORKER_BATCH_SIZE=50
NOTIFICATION_PROCESSING_LEASE_SECONDS=60
NOTIFICATION_ALLOW_PRIVATE_TARGETS=false
APPLICATION_URL=http://127.0.0.1:5173
LANGGRAPH_CHECKPOINT_DB=
LANGGRAPH_DEVELOPMENT=false
PLANNING_FORCE_INVALID_FIRST_ATTEMPT=false
IMPLEMENTATION_FORCE_INVALID_FIRST_ATTEMPT=false
LANGGRAPH_FAIL_AFTER_NODE=
SUPERVISOR_FORCE_MODEL_DECISION=false
SUPERVISOR_FORCE_TIMEOUT=false
SUPERVISOR_FORCE_INVALID_TARGET=false
SUPERVISOR_FORCE_TARGET=
SUPERVISOR_FORCE_STAGNANT_LOOP=false
DEFAULT_FASTAPI_REQUIREMENT=fastapi[standard]==0.139.0
DEFAULT_PYTEST_REQUIREMENT=pytest>=8,<9
API_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
WORKFLOW_EVENT_STORE_PATH=data/workflow-events.sqlite
MCP_CONNECT_TIMEOUT_SECONDS=15
MCP_TOOL_TIMEOUT_SECONDS=30
MCP_DISCONNECT_TIMEOUT_SECONDS=10
MCP_TOOL_TIMEOUT_TESTING_SECONDS=120
MCP_TOOL_TIMEOUT_FILESYSTEM_SECONDS=30
MCP_TOOL_TIMEOUT_KNOWLEDGE_SECONDS=30
MCP_TOOL_TIMEOUT_GIT_SECONDS=30
MCP_TOOL_TIMEOUT_TESTING_PREPARE_TEST_ENVIRONMENT_SECONDS=120
MCP_TOOL_TIMEOUT_TESTING_RUN_TESTS_SECONDS=120
AGENT_EVALUATION_HEURISTIC_WEIGHTS={"reliability_score":0.30,"latency_score":0.20,"cost_efficiency_score":0.20,"human_wait_score":0.10,"agent_efficiency_score":0.20}
AGENT_RECOMMENDATION_VERSION=8.5-v1
AGENT_RECOMMENDATION_MIN_SAMPLE_SIZE=20
AGENT_RECOMMENDATION_SEGMENT_MIN_SAMPLE_SIZE=10
WORKFLOW_EVENT_RETENTION_DAYS=30
WORKFLOW_EVENT_MAX_PER_THREAD=10000
ALERT_EVALUATION_ENABLED=true
ALERT_EVALUATION_INTERVAL_SECONDS=60
ALERT_EVALUATION_BATCH_SIZE=100
ALERT_SKIP_STARTUP_BACKFILL=false
# Durable end-to-end observability
OBSERVABILITY_ENABLED=true
OBSERVABILITY_JSON_LOGS=false
OBSERVABILITY_SLOW_SPAN_MS=2000
OBSERVABILITY_RECONCILE_ON_STARTUP=true
OBSERVABILITY_IGNORED_ROUTES=
OBSERVABILITY_IGNORED_PREFIXES=
OBSERVABILITY_POLLING_SAMPLE_RATE=0
OBSERVABILITY_CAPTURE_IGNORED_ERRORS=true
OBSERVABILITY_CLEANUP_PRESERVE_ERRORS=true
# Optional OTLP export. Local SQLite persistence remains authoritative.
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_HEADERS=
OTEL_SERVICE_NAME=mcp-software-factory
LLM_COSTS_ENABLED=true
LLM_COSTS_BASE_CURRENCY=USD
LLM_COSTS_DECIMAL_PLACES=12
LLM_COSTS_DISPLAY_DECIMAL_PLACES=6
LLM_COSTS_AUTO_CALCULATE=true
LLM_COSTS_ALLOW_ESTIMATES=true
LLM_COSTS_PRICING_MAX_AGE_DAYS=90
LLM_BUDGETS_ENABLED=true
LLM_BUDGET_FAIL_MODE=open
LLM_BUDGET_RESERVATION_TTL_SECONDS=300
LLM_BUDGET_DEFAULT_ENFORCEMENT=observe_only
LLM_COSTS_ALERTS_ENABLED=true
LLM_COSTS_SPIKE_MIN_SAMPLES=10
LLM_COSTS_SPIKE_MULTIPLIER=3
LLM_RETRY_COST_WARNING_RATIO=0.25
# Knowledge MCP and RAG
KNOWLEDGE_MAX_CONTENT_SIZE=100000
KNOWLEDGE_CHUNK_SIZE=1200
KNOWLEDGE_NEAR_DUPLICATE_THRESHOLD=0.92
KNOWLEDGE_AUTO_VALIDATE_TYPES=documentation,code_pattern,test_pattern
KNOWLEDGE_READ_FAIL_MODE=open
DEVELOPER_KNOWLEDGE_TOP_K=5
DEVELOPER_KNOWLEDGE_MAX_TOKENS=4000
PLANNER_KNOWLEDGE_TOP_K=5
PLANNER_KNOWLEDGE_MAX_TOKENS=3000
QA_KNOWLEDGE_TOP_K=5
QA_KNOWLEDGE_MAX_TOKENS=3000
REPAIR_KNOWLEDGE_TOP_K=5
REPAIR_KNOWLEDGE_MAX_TOKENS=3000
# Git MCP read-only foundation
GIT_COMMAND_TIMEOUT_SECONDS=10
GIT_OUTPUT_MAX_BYTES=500000
GIT_DIFF_MAX_BYTES=200000
GIT_LOG_MAX_ENTRIES=100
GIT_PROTECTED_BRANCHES=main,master,develop
GIT_AUTO_PREPARE_PROMOTION=false
GIT_PROMOTION_REQUIRED=false
GIT_PROMOTION_ALLOW_MERGE_COMMIT=true
GIT_COMMIT_MESSAGE_MAX_LENGTH=200
# Local CI pipeline
CI_PIPELINE_VERSION=6.21.1-v1
CI_PIPELINE_TIMEOUT_SECONDS=600
CI_STEP_TIMEOUT_SECONDS=180
CI_STEP_OUTPUT_MAX_CHARS=20000
CI_GATE_POLICY_VERSION=6.21.2-v1
CI_BUILD_GATE_BLOCKING=true
CI_TEST_GATE_BLOCKING=true
CI_LINT_GATE_BLOCKING=false
CI_PACKAGE_GATE_BLOCKING=false
CI_GIT_INTEGRATION_VERSION=6.21.3-v1
CI_PROMOTION_REQUIRED=true
CI_PROMOTION_ALLOW_WARNINGS=true
CI_REPAIR_VERSION=6.21.4-v1
CI_REPAIR_ENABLED=true
CI_REPAIR_MAX_ATTEMPTS=2
CI_OBSERVABILITY_VERSION=6.21.5-v1
CI_ANALYTICS_DEFAULT_LIMIT=500
CI_ANALYTICS_MAX_LIMIT=5000
# Planner policy experimentation statistics
POLICY_EXPERIMENT_CONFIDENCE_LEVEL=0.95
POLICY_EXPERIMENT_WINNER_CONFIDENCE_MIN=0.75
POLICY_EXPERIMENT_EQUIVALENCE_MARGIN=0.01
POLICY_EXPERIMENT_SAFETY_MIN_SAMPLE=5
POLICY_EXPERIMENT_PROMOTION_READINESS_MIN=80
POLICY_EXPERIMENT_STABILITY_MIN_SAMPLE=10
# Planner semantic judge
PLANNER_JUDGE_ENABLED=false
PLANNER_JUDGE_MODEL=
PLANNER_JUDGE_TIMEOUT_SECONDS=30
PLANNER_JUDGE_MAX_RETRIES=1
PLANNER_JUDGE_PROMPT_VERSION=8.1-v1
PLANNER_HYBRID_VERSION=8.2-v1
PLANNER_HYBRID_DETERMINISTIC_WEIGHT=0.70
PLANNER_HYBRID_JUDGE_WEIGHT=0.30
PLANNER_HYBRID_MAJOR_DISAGREEMENT_THRESHOLD=25
