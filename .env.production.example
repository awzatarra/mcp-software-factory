# Deployment identity and public service URLs
APP_ENV=production
FRONTEND_BASE_URL=https://factory.example.com
BACKEND_BASE_URL=https://api.factory.example.com
APPLICATION_URL=https://factory.example.com
VITE_API_BASE_URL=https://api.factory.example.com

# Persistent mounts. Phase 9.2 wires these roots into the selected platform.
WORKSPACE_ROOT=/var/lib/mcp-software-factory/workspace
DATA_ROOT=/var/lib/mcp-software-factory/data
LANGGRAPH_CHECKPOINT_DB=/var/lib/mcp-software-factory/data/langgraph-checkpoints.sqlite
WORKFLOW_EVENT_STORE_PATH=/var/lib/mcp-software-factory/data/workflow-events.sqlite

# Public/private boundaries
CORS_ALLOWED_ORIGINS=https://factory.example.com
API_CORS_ORIGINS=https://factory.example.com
MCP_NETWORK_MODE=private

# Runtime
USE_LANGGRAPH=true
MCP_FACTORY_DEBUG=false
LANGGRAPH_DEVELOPMENT=false
LOG_LEVEL=INFO
OBSERVABILITY_JSON_LOGS=true
NOTIFICATION_WORKER_ENABLED=true

# Secrets are injected by the deployment platform or a secret manager.
OPENAI_API_KEY=
OPENAI_MODEL=
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_HEADERS=

# Existing MCP transport timeouts
MCP_CONNECT_TIMEOUT_SECONDS=15
MCP_TOOL_TIMEOUT_SECONDS=30
MCP_DISCONNECT_TIMEOUT_SECONDS=10
MCP_TOOL_TIMEOUT_TESTING_SECONDS=120
MCP_TOOL_TIMEOUT_FILESYSTEM_SECONDS=30
MCP_TOOL_TIMEOUT_KNOWLEDGE_SECONDS=30
MCP_TOOL_TIMEOUT_GIT_SECONDS=30

# Existing Git, CI, and approval-sensitive policy defaults
GIT_AUTO_PREPARE_PROMOTION=false
GIT_PROMOTION_REQUIRED=false
CI_PROMOTION_REQUIRED=true
CI_PROMOTION_ALLOW_WARNINGS=true
CI_REPAIR_ENABLED=true
CI_REPAIR_MAX_ATTEMPTS=2

# Existing durable observability and FinOps controls
OBSERVABILITY_ENABLED=true
OBSERVABILITY_RECONCILE_ON_STARTUP=true
OBSERVABILITY_POLLING_SAMPLE_RATE=0
OBSERVABILITY_CAPTURE_IGNORED_ERRORS=true
LLM_COSTS_ENABLED=true
LLM_BUDGETS_ENABLED=true
LLM_BUDGET_FAIL_MODE=open
